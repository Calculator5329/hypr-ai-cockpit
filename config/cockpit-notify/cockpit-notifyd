def glyph(name: str, colour: str, size: int = 36):
    """Render one stroke glyph in a theme colour (SVG uses currentColor)."""
    key = (name, colour, size)
    if key in _GLYPHS:
        return _GLYPHS[key]
    pb = None
    try:
        svg = (GLYPH_DIR / f"{name}.svg").read_text().replace("currentColor", colour)
        loader = GdkPixbuf.PixbufLoader.new_with_type("svg")
        loader.set_size(size, size)
        loader.write(svg.encode())
        loader.close()
        pb = loader.get_pixbuf()
    except Exception:
        pb = None
    _GLYPHS[key] = pb
    return pb


def now_iso() -> str:
    return time.strftime("%Y-%m-%dT%H:%M:%S%z")


def ledger_append(rec: dict) -> None:
    try:
        LOG_DIR.mkdir(parents=True, exist_ok=True)
        with open(LOG_DIR / time.strftime("notify-%Y-%m.jsonl"), "a") as f:
            f.write(json.dumps({"ts": now_iso(), **rec}, ensure_ascii=False) + "\n")
    except Exception:
        pass


def read_mode() -> str:
